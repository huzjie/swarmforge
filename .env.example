# SwarmForge Configuration

# Environment
SWARMFORGE_ENV=development
SWARMFORGE_DEBUG=true
SWARMFORGE_LOG_LEVEL=DEBUG

# Security
SWARMFORGE_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
SWARMFORGE_API_KEY_HEADER=X-API-Key

# Database
SWARMFORGE_DATABASE_URL=postgresql+asyncpg://swarmforge:swarmforge@localhost:5432/swarmforge
SWARMFORGE_DATABASE_POOL_SIZE=20
SWARMFORGE_DATABASE_MAX_OVERFLOW=10

# Redis
SWARMFORGE_REDIS_URL=redis://localhost:6379/0

# LLM Providers (configure at least one)
SWARMFORGE_LLM_DEFAULT_PROVIDER=openai
SWARMFORGE_OPENAI_API_KEY=sk-your-openai-key
SWARMFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
SWARMFORGE_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
SWARMFORGE_DEEPSEEK_API_KEY=sk-your-deepseek-key
SWARMFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
SWARMFORGE_GOOGLE_API_KEY=your-google-ai-key
SWARMFORGE_AZURE_OPENAI_API_KEY=your-azure-key
SWARMFORGE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Agent Execution
SWARMFORGE_MAX_CONCURRENT_AGENTS=50
SWARMFORGE_AGENT_TIMEOUT_SECONDS=300
SWARMFORGE_MAX_RETRIES=3
SWARMFORGE_EXECUTION_SANDBOX_ENABLED=true

# Rate Limiting
SWARMFORGE_RATE_LIMIT_REQUESTS=100
SWARMFORGE_RATE_LIMIT_PERIOD_SECONDS=60

# Monitoring
SWARMFORGE_PROMETHEUS_ENABLED=true
SWARMFORGE_OTEL_ENABLED=false
SWARMFORGE_OTEL_ENDPOINT=http://localhost:4317

# CORS
SWARMFORGE_CORS_ORIGINS=*

# Storage
SWARMFORGE_ARTIFACT_STORAGE_PATH=./data/artifacts
SWARMFORGE_MAX_ARTIFACT_SIZE_MB=100
